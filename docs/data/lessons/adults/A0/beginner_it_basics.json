            "description": "Знакомство с коллегами и основные утверждения",
            "grammar": {
                "title": "Verb 'to be' (I am / You are)",
                "rule": "📘 Глагол 'to be' (быть):\n\n✅ I am = I'm (Я есть)\n✅ You are = You're (Ты/Вы есть)\n\n📌 Примеры:\nI am a developer. = I'm a developer.\nYou are a tester. = You're a tester.\n\n⚠️ В английском нельзя сказать 'I developer'. Нужно обязательно 'I am a developer'.",
                "examples": []
            },
            "vocabulary": [
                {"icon": "👨‍💻", "word": "developer", "transcription": "/dɪˈveləpə/", "translation": "разработчик", "example": "I'm a developer.", "context_translation": "разработчик", "context_example": "Я разработчик."},
                {"icon": "🧪", "word": "tester", "transcription": "/ˈtestə/", "translation": "тестировщик", "example": "You're a tester.", "context_translation": "тестировщик", "context_example": "Ты тестировщик."},
                {"icon": "📊", "word": "manager", "transcription": "/ˈmænɪdʒə/", "translation": "менеджер", "example": "I'm a manager.", "context_translation": "менеджер", "context_example": "Я менеджер."},
                {"icon": "🌍", "word": "team", "transcription": "/tiːm/", "translation": "команда", "example": "You're in the QA team.", "context_translation": "команда", "context_example": "Ты в команде QA."}
