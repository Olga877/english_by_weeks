                "examples": [
                    "I am a student. (Я студент)",
                    "You are my friend. (Ты мой друг)",
                    "He is Leo. (Он Лео)",
                    "She is Mia. (Она Мия)",
                    "It is a cat. (Это кошка)",
                    "We are classmates. (Мы одноклассники)",
                    "They are teachers. (Они учителя)"
                ]
            },
            "vocabulary": [
                {"icon": "✅", "word": "am", "transcription": "/æm/", "translation": "являюсь (для I)", "example": "I am a student", "context_translation": "являюсь", "context_example": "я студент"},
                {"icon": "✅", "word": "is", "transcription": "/ɪz/", "translation": "является (для he/she/it)", "example": "She is happy", "context_translation": "является", "context_example": "она счастлива"},
