            "grammar": {
                "title": "Personal Pronouns",
                "rule": "Местоимения заменяют имена существительные:\n\n• I = я (говорит о себе)\n• you = ты, вы (к кому обращаемся)\n• he = он (мальчик, мужчина)\n• she = она (девочка, женщина)\n• it = оно (предмет, животное)\n• we = мы (группа, включая говорящего)\n• they = они (группа людей или предметов)",
                "examples": [
                    "I am a student.",
                    "You are my friend.",
                    "He is Leo.",
                    "She is Mia.",
                    "It is a cat.",
                    "We are classmates.",
                    "They are teachers."
                ]
            },
            "vocabulary": [
                {"icon": "👤", "word": "I", "transcription": "/aɪ/", "translation": "я", "example": "I am happy today", "context_translation": "я", "context_example": "я сегодня счастлив"},
